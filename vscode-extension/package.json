{
  "name": "genshen-skirk-skin",
  "displayName": "丝柯克动态皮肤（原神）",
  "description": "原神丝柯克动态皮肤：点击播放大招中文语音与爆发动画，胶囊右键一键卸载。适用于 VSCode 与 Trae-IDE。",
  "version": "1.0.0",
  "publisher": "wp666",
  "icon": "icon.png",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Other"],
  "keywords": ["genshin", "skirk", "原神", "丝柯克", "skin"],
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": { "type": "git", "url": "https://github.com/WPH666-py/Genshen-Skirk-Skin" },
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "skirkSkin.show", "title": "丝柯克皮肤：显示", "icon": "$(sparkle)" },
      { "command": "skirkSkin.uninstall", "title": "丝柯克皮肤：一键卸载", "icon": "$(trash)" }
    ]
  }
}
